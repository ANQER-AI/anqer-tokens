      },
      "brand-mark": "#ed3500",
      "cherry": "#9b1b3b",
      "action": {
        "DEFAULT": "#3d8eb9",
        "ink": "#2f6f92"
      },
      "surface": {
        "chrome": "#ffffff",
        "wash": "#f4f6f9",
        "well": "#f1f3f7"
      },
      "rule": {
        "strong": "#c9d0d9",
        "hairline": "#e4e7ec",
        "soft": "#e2e6eb",
        "hairline-soft": "#ebedf0"
      },
      "ink": {
        "DEFAULT": "#09101b",
        "chrome": "#1e2a3a",
        "body": "#39424f",
