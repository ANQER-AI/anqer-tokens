      },
      "fit": {
        "yes": {
          "DEFAULT": "#22c55e",
          "ink": "#166534",
          "ink-strong": "#14532d",
          "on-navy": "#bbf7d0"
        },
        "no": {
          "DEFAULT": "#ef4444",
          "ink": "#991b1b",
          "ink-strong": "#7f1d1d",
          "on-navy": "#fecaca"
        }
      },
      "setup": {
        "done": "#16a34a",
